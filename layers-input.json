{
    "titiler_url": "https://titiler.nrp-nautilus.io",
    "links": {
        "github": "https://github.com/SchmidtDSE/glen-portolan-mojave"
    },
    "default_basemap": "natgeo",
    "view": {
        "center": [-116.33, 34.07],
        "zoom": 13
    },
    "collections": [
        {
            "url": "https://storage.googleapis.com/dse-nps-fire-severity-storage/v2/fires/eureka-9c3382ee/eureka-9c3382ee/collection.json",
            "display_name": "Eureka fire burn severity",
            "group": "Eureka fire (2025)",
            "colormap": "rdylgn_r",
            "items": [
                {
                    "id": "severity",
                    "assets": [
                        {
                            "id": "rbr",
                            "display_name": "Burn severity: RBR",
                            "visible": true,
                            "rescale": "0,0.5"
                        },
                        {
                            "id": "dnbr",
                            "display_name": "Burn severity: dNBR",
                            "rescale": "-0.1,0.66"
                        },
                        {
                            "id": "rdnbr",
                            "display_name": "Burn severity: RdNBR",
                            "rescale": "0,0.8"
                        }
                    ]
                }
            ]
        },
        {
            "url": "https://s3-west.nrp-nautilus.io/public-fire/calfire-2025/firep/stac-collection.json",
            "id": "eureka-perimeter",
            "display_name": "Eureka fire perimeter (CAL FIRE)",
            "group": "Eureka fire (2025)",
            "visible": true,
            "default_filter": ["all",
                ["==", ["get", "FIRE_NAME"], "EUREKA"],
                ["==", ["get", "YEAR_"], 2025]
            ],
            "default_style": {
                "fill-color": "#000000",
                "fill-opacity": 0
            },
            "outline_style": {
                "line-color": "#212121",
                "line-width": 2
            },
            "tooltip": [
                "FIRE_NAME",
                "YEAR_",
                "ALARM_DATE",
                "GIS_ACRES",
                "UNIT_ID"
            ]
        },
        {
            "url": "https://jotr-nps-portolan.org/jotr-vegmap/collection.json",
            "display_name": "JOTR vegetation map",
            "group": "Joshua Tree NP",
            "items": [
                {
                    "id": "park-boundary",
                    "display_name": "Park boundary",
                    "visible": true,
                    "default_style": {
                        "fill-color": "#000000",
                        "fill-opacity": 0
                    },
                    "outline_style": {
                        "line-color": "#5D4037",
                        "line-width": 2
                    },
                    "tooltip": [
                        "Park_Name",
                        "Acres"
                    ]
                },
                {
                    "id": "vegetation-map",
                    "display_name": "Vegetation map units",
                    "tooltip": [
                        "MapUnit_Name",
                        "MapUnit_ID",
                        "Acres"
                    ]
                }
            ]
        }
    ],
    "sidebar": {
        "enabled": true,
        "title": "Joshua Tree NP: Eureka fire",
        "chat_title": "Chat"
    },
    "plugins": [
        {
            "url": "https://cdn.jsdelivr.net/gh/SchmidtDSE/glen@v3.51.1/core/plugins/mcp.js",
            "options": {
                "servers": [
                    {
                        "worker": "plugins/geo-query-worker.js",
                        "worker_config": {
                            "discovery": false
                        },
                        "include": [
                            "query"
                        ]
                    }
                ]
            }
        }
    ],
    "auto_approve": true,
    "llm": {
        "user_provided": true,
        "default_endpoint": "https://openrouter.ai/api/v1",
        "models": [
            {
                "value": "~deepseek/deepseek-v4-flash-latest",
                "label": "DeepSeek V4 Flash"
            },
            {
                "value": "nvidia/nemotron-3.5-super-vl",
                "label": "Nemotron 3.5 Super"
            },
            {
                "value": "z-ai/glm-5.3-flash",
                "label": "GLM-5.3 Flash"
            },
            {
                "value": "minimax/minimax-m3.1-flash",
                "label": "MiniMax M3.1 Flash"
            }
        ]
    },
    "welcome": {
        "message": "I can show, recolour and compare the Eureka fire (2025) burn-severity maps in Joshua Tree, and the Joshua Tree vegetation map. Try asking:",
        "examples": [
            "Switch from RBR to dNBR",
            "Recolour the RBR layer with magma from 0 to 0.4",
            "Show only the Joshua Tree Woodland Alliance polygons"
        ]
    }
}
