{
    "titiler_url": "https://titiler.nrp-nautilus.io",
    "links": {
        "github": "https://github.com/SchmidtDSE/glen-portolan-mojave"
    },
    "default_basemap": "natgeo",
    "view": {
        "center": [-116.36, 34.064],
        "zoom": 12.6
    },
    "collections": [
        {
            "url": "https://storage.googleapis.com/dse-nps-fire-severity-storage/v2/fires/2025-eureka-0928336c/2025-eureka-0928336c/collection.json",
            "display_name": "Eureka burn severity",
            "group": "Eureka fire (2025)",
            "items": [
                {
                    "id": "rbr",
                    "assets": [
                        { "id": "rbr", "display_name": "Eureka: RBR", "visible": true, "rescale": "0,0.65" }
                    ]
                },
                {
                    "id": "dnbr",
                    "assets": [
                        { "id": "dnbr", "display_name": "Eureka: dNBR" }
                    ]
                },
                {
                    "id": "rdnbr",
                    "assets": [
                        { "id": "rdnbr", "display_name": "Eureka: RdNBR" }
                    ]
                }
            ]
        },
        {
            "url": "https://storage.googleapis.com/dse-nps-fire-severity-storage/v2/fires/2025-eureka-0928336c/2025-eureka-0928336c-perimeter/collection.json",
            "display_name": "Eureka fire perimeter",
            "group": "Eureka fire (2025)",
            "visible": true,
            "default_style": {
                "fill-color": "#000000",
                "fill-opacity": 0
            },
            "outline_style": {
                "line-color": "#212121",
                "line-width": 2
            },
            "tooltip": [
                "fire_event_name"
            ]
        },
        {
            "url": "https://storage.googleapis.com/dse-nps-fire-severity-storage/v2/fires/2025-blackrock-5fc03749/2025-blackrock-5fc03749/collection.json",
            "display_name": "Black Rock burn severity",
            "group": "Black Rock fire (2025)",
            "items": [
                {
                    "id": "rbr",
                    "assets": [
                        { "id": "rbr", "display_name": "Black Rock: RBR", "visible": true, "rescale": "0,0.65" }
                    ]
                },
                {
                    "id": "dnbr",
                    "assets": [
                        { "id": "dnbr", "display_name": "Black Rock: dNBR" }
                    ]
                },
                {
                    "id": "rdnbr",
                    "assets": [
                        { "id": "rdnbr", "display_name": "Black Rock: RdNBR" }
                    ]
                }
            ]
        },
        {
            "url": "https://storage.googleapis.com/dse-nps-fire-severity-storage/v2/fires/2025-blackrock-5fc03749/2025-blackrock-5fc03749-perimeter/collection.json",
            "display_name": "Black Rock fire perimeter",
            "group": "Black Rock fire (2025)",
            "visible": true,
            "default_style": {
                "fill-color": "#000000",
                "fill-opacity": 0
            },
            "outline_style": {
                "line-color": "#212121",
                "line-width": 2
            },
            "tooltip": [
                "fire_event_name"
            ]
        },
        {
            "url": "https://jotr-nps-portolan.org/vegetation-map/collection.json",
            "display_name": "JOTR vegetation map",
            "group": "Joshua Tree NP",
            "items": [
                {
                    "id": "vegetation-map",
                    "display_name": "Vegetation map units",
                    "visible": true,
                    "tooltip": [
                        "MapUnit_Name",
                        "MapUnit_ID",
                        "Acres"
                    ]
                }
            ]
        },
        {
            "url": "https://jotr-nps-portolan.org/park-boundary/collection.json",
            "display_name": "JOTR park boundary",
            "group": "Joshua Tree NP",
            "items": [
                {
                    "id": "park-boundary",
                    "display_name": "Park boundary",
                    "visible": true,
                    "tooltip": [
                        "Park_Name",
                        "Acres"
                    ]
                }
            ]
        }
    ],
    "sidebar": {
        "enabled": true,
        "title": "Joshua Tree NP: 2025 fires",
        "chat_title": "Chat"
    },
    "plugins": [
        {
            "url": "https://cdn.jsdelivr.net/gh/SchmidtDSE/glen@v4.0.6/core/plugins/mcp.js",
            "options": {
                "servers": [
                    {
                        "worker": "plugins/geo-query-worker.js",
                        "worker_config": {
                            "discovery": false,
                            "zonalStats": true,
                            "allowedDirectories": [
                                "s3://",
                                "https://s3-west.nrp-nautilus.io/",
                                "https://s3.us-west-2.amazonaws.com/us-west-2.opendata.source.coop/",
                                "https://data.source.coop/",
                                "https://storage.googleapis.com/dse-nps-fire-severity-storage/",
                                "https://jotr-nps-portolan.org/"
                            ]
                        },
                        "include": [
                            "query",
                            "zonal_stats",
                            "register_hex_tiles",
                            "get_hex_tile_status"
                        ]
                    }
                ]
            }
        },
        "https://cdn.jsdelivr.net/gh/SchmidtDSE/glen@v4.0.6/core/plugins/charts.js",
        {
            "url": "https://cdn.jsdelivr.net/gh/SchmidtDSE/glen@v4.0.6/core/plugins/hex.js",
            "options": {
                "geo_query_wasm": "v0.6.0"
            }
        }
    ],
    "system_prompt_url": "system-prompt.md",
    "auto_approve": true,
    "llm": {
        "user_provided": true,
        "default_endpoint": "https://openrouter.ai/api/v1",
        "models": [
            {
                "value": "z-ai/glm-5.3-flash",
                "label": "GLM-5.3 Flash"
            },
            {
                "value": "~deepseek/deepseek-v4-flash-latest",
                "label": "DeepSeek V4 Flash"
            },
            {
                "value": "nvidia/nemotron-3.5-super-vl",
                "label": "Nemotron 3.5 Super"
            },
            {
                "value": "minimax/minimax-m3.1-flash",
                "label": "MiniMax M3.1 Flash"
            }
        ]
    },
    "welcome": {
        "message": "I can map and measure burn severity for the Eureka and Black Rock fires (2025) in Joshua Tree against the park's vegetation map. You choose the thresholds. Try the first three in order:",
        "examples": [
            "Chart exact hectares in each fire split at RBR 0.1 and 0.27",
            "Now map where RBR ≥ 0.27 overlaps Joshua tree woodland in both fires",
            "Chart Joshua tree habitat suitability within those areas",
            "Show me just the pinyon pine associations in the park",
            "Show me areas where RBR was over 0.45 in both fires"
        ]
    }
}
