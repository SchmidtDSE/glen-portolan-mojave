{
    "titiler_url": "https://titiler.nrp-nautilus.io",
    "links": {
        "github": "https://github.com/SchmidtDSE/glen-portolan-mojave"
    },
    "default_basemap": "natgeo",
    "view": {
        "center": [-116.33, 34.07],
        "zoom": 13
    },
    "collections": [
        {
            "url": "https://storage.googleapis.com/dse-nps-fire-severity-storage/v2/fires/eureka-badc3220/eureka-badc3220/collection.json",
            "display_name": "Eureka fire burn severity",
            "group": "Eureka fire (2025)",
            "items": [
                {
                    "id": "rbr",
                    "assets": [
                        { "id": "rbr", "display_name": "Burn severity: RBR", "visible": true }
                    ]
                },
                {
                    "id": "dnbr",
                    "assets": [
                        { "id": "dnbr", "display_name": "Burn severity: dNBR" }
                    ]
                },
                {
                    "id": "rdnbr",
                    "assets": [
                        { "id": "rdnbr", "display_name": "Burn severity: RdNBR" }
                    ]
                }
            ]
        },
        {
            "url": "https://storage.googleapis.com/dse-nps-fire-severity-storage/v2/fires/eureka-badc3220/eureka-badc3220-perimeter/collection.json",
            "display_name": "Eureka fire perimeter",
            "group": "Eureka fire (2025)",
            "visible": true,
            "default_style": {
                "fill-color": "#000000",
                "fill-opacity": 0
            },
            "outline_style": {
                "line-color": "#212121",
                "line-width": 2
            },
            "tooltip": [
                "fire_event_name"
            ]
        },
        {
            "url": "https://jotr-nps-portolan.org/jotr-vegmap/collection.json",
            "display_name": "JOTR vegetation map",
            "group": "Joshua Tree NP",
            "items": [
                {
                    "id": "park-boundary",
                    "display_name": "Park boundary",
                    "visible": true,
                    "default_style": {
                        "fill-color": "#000000",
                        "fill-opacity": 0
                    },
                    "outline_style": {
                        "line-color": "#5D4037",
                        "line-width": 2
                    },
                    "tooltip": [
                        "Park_Name",
                        "Acres"
                    ]
                },
                {
                    "id": "vegetation-map",
                    "display_name": "Vegetation map units",
                    "visible": true,
                    "default_style": {
                        "fill-color": "#000000",
                        "fill-opacity": 0
                    },
                    "outline_style": {
                        "line-color": "#5D4037",
                        "line-width": 2
                    },
                    "tooltip": [
                        "MapUnit_Name",
                        "MapUnit_ID",
                        "Acres"
                    ]
                }
            ]
        }
    ],
    "sidebar": {
        "enabled": true,
        "title": "Joshua Tree NP: Eureka fire",
        "chat_title": "Chat"
    },
    "plugins": [
        {
            "url": "https://cdn.jsdelivr.net/gh/SchmidtDSE/glen@v3.51.1/core/plugins/mcp.js",
            "options": {
                "servers": [
                    {
                        "worker": "plugins/geo-query-worker.js",
                        "worker_config": {
                            "discovery": false,
                            "zonalStats": true,
                            "allowedDirectories": [
                                "s3://",
                                "https://s3-west.nrp-nautilus.io/",
                                "https://s3.us-west-2.amazonaws.com/us-west-2.opendata.source.coop/",
                                "https://data.source.coop/",
                                "https://storage.googleapis.com/dse-nps-fire-severity-storage/",
                                "https://jotr-nps-portolan.org/"
                            ]
                        },
                        "include": [
                            "query",
                            "zonal_stats",
                            "register_hex_tiles",
                            "get_hex_tile_status"
                        ]
                    }
                ]
            }
        },
        "https://cdn.jsdelivr.net/gh/SchmidtDSE/glen@v3.51.1/core/plugins/charts.js",
        {
            "url": "https://cdn.jsdelivr.net/gh/SchmidtDSE/glen@v3.51.1/core/plugins/hex.js",
            "options": {
                "geo_query_wasm": "v0.6.0"
            }
        }
    ],
    "system_prompt_url": "system-prompt.md",
    "auto_approve": true,
    "llm": {
        "user_provided": true,
        "default_endpoint": "https://openrouter.ai/api/v1",
        "models": [
            {
                "value": "~deepseek/deepseek-v4-flash-latest",
                "label": "DeepSeek V4 Flash"
            },
            {
                "value": "nvidia/nemotron-3.5-super-vl",
                "label": "Nemotron 3.5 Super"
            },
            {
                "value": "z-ai/glm-5.3-flash",
                "label": "GLM-5.3 Flash"
            },
            {
                "value": "minimax/minimax-m3.1-flash",
                "label": "MiniMax M3.1 Flash"
            }
        ]
    },
    "welcome": {
        "message": "I can map and measure the Eureka fire (2025) burn severity in Joshua Tree against the park's vegetation map. You choose the thresholds. Try asking:",
        "examples": [
            "Hectares with RBR ≥ 0.5 inside the Eureka perimeter, and their mean RBR",
            "Chart hectares burned per vegetation class inside the perimeter, split at RBR 0.1 and 0.27",
            "Mean RBR in Joshua Tree - California Juniper / Nevada Ephedra Woodland inside the perimeter"
        ]
    }
}
