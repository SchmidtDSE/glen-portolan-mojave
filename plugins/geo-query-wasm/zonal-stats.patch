+/** The signed area of a ring, by the shoelace formula. */
+export function ringArea(ring) {
+    let a = 0;
+    for (let k = 0; k < ring.length; k++) {
+        const [x1, y1] = ring[k];
+        const [x2, y2] = ring[(k + 1) % ring.length];
