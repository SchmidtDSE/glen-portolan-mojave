+        const hi = c + 1 - xl;
+        const lo = c + 1 - xh;
+        const share = hi - lo > 1e-12
+            ? (rampIntegral(hi) - rampIntegral(lo)) / (hi - lo)
+            : Math.min(1, Math.max(0, (hi + lo) / 2));
